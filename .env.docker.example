# Copy this file to .env.docker and replace every CHANGE_ME value.
# Generate each secret with:  openssl rand -hex 32
# BACK UP .env.docker somewhere safe and never commit it.
# Do NOT change NYDRA_VAULT_KEY / NYDRA_VAULT_SALT after users have saved
# LLM provider keys: those keys would become undecryptable.
# Changing SECRET_KEY logs every user out.

NYDRA_VAULT_KEY=CHANGE_ME
NYDRA_VAULT_SALT=CHANGE_ME
SECRET_KEY=CHANGE_ME

DATABASE_URL=sqlite+aiosqlite:////data/nydra.db
UPLOAD_DIR=/data/uploads
REPORT_DIR=/data/reports

MAX_FILE_MB=200
MAX_CHUNKED_GB=0.5
MAX_USER_STORAGE_MB=2048
MAX_ACTIVE_JOBS_PER_USER=2
MAX_QUEUE_DEPTH=20

FORWARDED_ALLOW_IPS=*